{
  "name": "dml-lms",
  "private": true,
  "version": "0.1.0",
  "description": "Data Mine Labs LMS: AML/CFT training for Licensed Exchange Houses.",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev:server": "npm run start:dev -w server",
    "dev:client": "npm run dev -w client",
    "typecheck": "npm run typecheck -w server && npm run typecheck -w client",
    "lint": "eslint server client/src client/e2e tools",
    "format": "prettier --write \"{server,client}/src/**/*.{ts,tsx,css}\" \"tools/**/*.mjs\"",
    "format:check": "prettier --check \"{server,client}/src/**/*.{ts,tsx,css}\" \"client/*.ts\" \"client/e2e/*.mjs\" \"tools/**/*.mjs\"",
    "check:files": "node tools/check-file-size.mjs",
    "test": "npm run test -w server && npm run test -w client",
    "test:integration": "npm run test:integration -w server",
    "build": "npm run build -w server && npm run build -w client",
    "verify": "npm run check:files && npm run lint && npm run typecheck && npm test && npm run build",
    "prepare": "husky",
    "test:e2e": "node client/e2e/learner-journey.e2e.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.2",
    "playwright": "^1.63.0",
    "prettier": "^3.10.1",
    "typescript-eslint": "^8.74.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --max-warnings=0",
      "prettier --check"
    ]
  }
}
