# Copy to .env for local development. Never commit real values.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://lms:lms_dev@localhost:5432/lms?schema=public
# At least 32 random characters. Generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-of-32-chars-or-more
JWT_EXPIRES_IN=1h
# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173
# Requests per minute per client.
RATE_LIMIT_PER_MINUTE=120
LOG_LEVEL=log
# Public address of the web app; printed on certificates so anyone can verify them.
PUBLIC_APP_URL=http://localhost:5173
